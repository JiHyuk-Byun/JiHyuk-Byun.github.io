permalink: /blog/recent-posts.json
---
[{% assign ps = site.posts | where_exp: "p", "p.hidden != true" %}{% for post in ps limit: 6 %}{"title": {{ post.title | jsonify }}, "url": {{ post.url | jsonify }}, "date": {{ post.date | date: "%b %Y" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
